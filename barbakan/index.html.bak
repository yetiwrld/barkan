<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Barbakan Delicatessen &amp; Bakery | Authentic Artisan Baked in Manchester Since 1964</title>
<meta name="description" content="Barbakan Delicatessen &amp; Bakery — Manchester's finest artisan bakery since 1964. Award-winning breads, continental deli products, and handmade pastries in Chorlton and Wilmslow.">
<meta property="og:title" content="Barbakan Delicatessen &amp; Bakery | Manchester Since 1964">
<meta property="og:description" content="Award-winning artisan bakery &amp; continental deli in Chorlton &amp; Wilmslow. 62 years of authentic, handmade baking.">
<meta property="og:type" content="website">
<link rel="canonical" href="https://barbakan-deli.co.uk">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--cream:#FFF9F2;--warm-white:#FFFDF9;--cream-dark:#F5EDE0;--dark:#1A1209;--warm-brown:#5C3D2E;--primary:#8B1A1A;--primary-dark:#6B1414;--gold:#C8951A;--green:#4A6741;--border:#E8DDD0;--text-muted:#7A6555;--sh-sm:0 1px 3px rgba(26,18,9,.06);--sh-md:0 4px 16px rgba(26,18,9,.1);--r-sm:4px;--r-md:8px;--r-lg:16px;--t:.25s ease;--max-w:1200px;--pad:clamp(4rem,8vw,7rem)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--cream);color:var(--dark);line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4{font-family:'Playfair Display',Georgia,serif;line-height:1.2;font-weight:700;color:var(--dark)}
h1{font-size:clamp(2.4rem,6vw,4.5rem)}h2{font-size:clamp(2rem,4vw,3rem)}h3{font-size:clamp(1.4rem,2.5vw,1.9rem)}h4{font-size:1.25rem}
.container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 clamp(1rem,4vw,2rem)}
.section{padding:var(--pad) 0}.section--alt{background:var(--cream-dark)}.section--white{background:var(--warm-white)}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.75rem;font-family:'DM Sans',sans-serif;font-size:.9rem;font-weight:600;border:none;border-radius:var(--r-sm);cursor:pointer;transition:var(--t);text-decoration:none;white-space:nowrap}
.btn-primary{background:var(--primary);color:#fff}.btn-primary:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:var(--sh-md)}
.btn-outline{background:transparent;color:var(--primary);border:2px solid var(--primary)}.btn-outline:hover{background:var(--primary);color:#fff}
.btn-gold{background:var(--gold);color:#fff}.btn-gold:hover{background:#b88416;transform:translateY(-1px);box-shadow:var(--sh-md)}
.btn-white{background:#fff;color:var(--primary)}.btn-white:hover{background:var(--cream-dark);transform:translateY(-1px)}
.text-center{text-align:center}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
.site-header{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(255,249,242,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);transition:var(--t)}
.site-header.scrolled{box-shadow:var(--sh-sm)}
.site-header .container{display:flex;align-items:center;justify-content:space-between;height:68px;gap:2rem}
.site-logo{display:flex;align-items:center;gap:.6rem;flex-shrink:0}
.site-logo-text{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;color:var(--dark);line-height:1}
.site-logo-tagline{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);display:block;margin-top:2px}
.site-nav{display:flex;align-items:center}
.site-nav a{font-size:.875rem;font-weight:500;color:var(--warm-brown);padding:.5rem .85rem;border-radius:var(--r-sm);transition:var(--t)}
.site-nav a:hover,.site-nav a.active{color:var(--primary);background:rgba(139,26,26,.06)}
.nav-cta{margin-left:1rem}
@media(max-width:900px){.site-nav{display:none}.mobile-toggle{display:block;background:none;border:none;cursor:pointer;padding:.5rem;color:var(--dark)}}
.mobile-toggle svg{width:24px;height:24px;display:block}
.mobile-nav{display:none;position:fixed;inset:68px 0 0 0;background:var(--cream);padding:2rem;flex-direction:column;gap:.25rem;border-top:1px solid var(--border);overflow-y:auto;z-index:999}
.mobile-nav.open{display:flex}
.mobile-nav a{font-size:1.1rem;font-weight:500;color:var(--warm-brown);padding:.85rem 1rem;border-radius:var(--r-md);transition:var(--t)}
.mobile-nav a:hover,.mobile-nav a.active{color:var(--primary);background:rgba(139,26,26,.06)}
.hero{min-height:100vh;display:flex;align-items:center;background:var(--dark);position:relative;overflow:hidden;padding-top:68px}
.hero-bg{position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,18,9,.9) 0%,rgba(139,26,26,.65) 100%)}
.hero-pattern{position:absolute;inset:0;opacity:.04;background-image:radial-gradient(circle 80px at 20% 30%,#fff 1px,transparent 1px),radial-gradient(circle 80px at 80% 70%,#fff 1px,transparent 1px),radial-gradient(circle 60px at 50% 50%,#fff 1px,transparent 1px);background-size:200px 200px,280px 280px,160px 160px}
.hero-content{position:relative;z-index:1;color:#fff;max-width:720px}
.hero-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(200,149,26,.2);border:1px solid rgba(200,149,26,.4);color:var(--gold);font-size:.75rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;padding:.4rem 1rem;border-radius:100px;margin-bottom:1.5rem}
.hero h1{color:#fff;margin-bottom:1.25rem}
.hero-sub{font-size:clamp(1.05rem,2vw,1.25rem);color:rgba(255,255,255,.8);margin-bottom:2.5rem;line-height:1.7}
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
.hero-awards{position:absolute;bottom:2rem;right:clamp(1rem,4vw,3rem);display:flex;flex-direction:column;gap:.75rem;z-index:1}
@media(max-width:600px){.hero-awards{display:none}}
.award-badge{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(8px);padding:.6rem 1rem;border-radius:var(--r-md);color:rgba(255,255,255,.9);font-size:.8rem;text-align:center}
.award-badge strong{display:block;font-size:1.25rem;color:var(--gold)}
.hero-scroll{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);z-index:1;display:flex;flex-direction:column;align-items:center;gap:.4rem;color:rgba(255,255,255,.4);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;animation:bounce 2s infinite}
@keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(6px)}}
</style>
<link rel="stylesheet" href="assets/css/styles.css">
</head>
<body>
